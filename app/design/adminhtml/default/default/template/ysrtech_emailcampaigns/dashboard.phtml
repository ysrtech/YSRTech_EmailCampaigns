<div class="ysrtech-ec-cols">
    <div class="ysrtech-ec-col wide">
        <div class="entry-edit">
            <div class="entry-edit-head"><h4><?php echo $this->escapeHtml($this->__('Delivery Over Time')) ?></h4></div>
            <div class="fieldset">
                <ul class="ysrtech-ec-legend">
                    <?php foreach ($labels as $key => $label): ?>
                        <li><i style="background:<?php echo $this::COLORS[$key] ?>"></i><?php echo $this->escapeHtml($label) ?></li>
                    <?php endforeach ?>
                </ul>
                <div class="ysrtech-ec-chart-wrap" id="ysrtech-ec-chart">
                    <?php echo $chart['svg'] ?>
                    <div class="ysrtech-ec-tip" style="display:none"></div>
                </div>
                <p class="note"><?php echo $this->escapeHtml($this->__('Messages per day, by the day they were sent, in the store\'s timezone.')) ?></p>
            </div>
        </div>
    </div>
    <div class="ysrtech-ec-col">
        <div class="entry-edit">
            <div class="entry-edit-head"><h4><?php echo $this->escapeHtml($this->__('Delivery Funnel')) ?></h4></div>
            <div class="fieldset">
                <?php foreach ([
                    [$this->__('Sent'), $totals['sent'], '#2a78d6'],
                    [$this->__('Delivered'), $totals['delivered'], '#2a78d6'],
                    [$this->__('Opened (real)'), $totals['opened'], '#1baf7a'],
