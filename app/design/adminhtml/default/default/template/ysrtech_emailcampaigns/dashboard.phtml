    <div class="grid">
        <table cellspacing="0" class="data">
            <thead>
                <tr class="headings">
                    <th><?php echo $this->escapeHtml($this->__('Provider')) ?></th>
                    <th class="a-right"><?php echo $this->escapeHtml($this->__('Sent')) ?></th>
                    <th class="a-right"><?php echo $this->escapeHtml($this->__('Share')) ?></th>
                    <th class="a-right"><?php echo $this->escapeHtml($this->__('Delivered')) ?></th>
                    <th class="a-right"><?php echo $this->escapeHtml($this->__('Real Opens')) ?></th>
                    <th class="a-right"><?php echo $this->escapeHtml($this->__('Machine Opens')) ?></th>
                    <th class="a-right"><?php echo $this->escapeHtml($this->__('Clicks')) ?></th>
                    <th class="a-right"><?php echo $this->escapeHtml($this->__('Bounces')) ?></th>
                    <th class="a-right"><?php echo $this->escapeHtml($this->__('Spam')) ?></th>
                </tr>
            </thead>
            <tbody>
            <?php if (!$stats['providers']): ?>
                <tr><td colspan="9" class="empty-text a-center"><?php echo $this->escapeHtml($this->__('Nothing was sent in this period.')) ?></td></tr>
            <?php endif ?>
            <?php foreach ($stats['providers'] as $i => $p): ?>
                <?php $bounce = $rate($p['bounced'], $p['sent']); $spam = $rate($p['complained'], $p['delivered']); ?>
                <tr class="<?php echo $i % 2 ? 'odd' : 'even' ?>">
                    <td><?php echo $this->escapeHtml($p['name']) ?></td>
                    <td class="a-right"><?php echo number_format($p['sent']) ?></td>
                    <td class="a-right"><?php echo $pct($rate($p['sent'], $totals['sent']), 0) ?></td>
                    <td class="a-right"><?php echo $pct($rate($p['delivered'], $p['sent'])) ?></td>
                    <td class="a-right"><?php echo $p['delivered'] ? $pct($rate($p['opened'], $p['delivered'])) : $dash ?></td>
                    <td class="a-right"><?php echo $p['delivered'] ? $pct($rate($p['machine'], $p['delivered'])) : $dash ?></td>
                    <td class="a-right"><?php echo $p['delivered'] ? $pct($rate($p['clicked'], $p['delivered'])) : $dash ?></td>
                    <td class="a-right<?php if ($bounce >= $S::BOUNCE_WARN): ?> ysrtech-ec-flag<?php endif ?>"><?php echo $pct($bounce, 2) ?></td>
                    <td class="a-right<?php if ($spam >= $S::COMPLAINT_WARN): ?> ysrtech-ec-flag<?php endif ?>"><?php echo $p['delivered'] ? $pct($spam, 3) : $dash ?></td>
