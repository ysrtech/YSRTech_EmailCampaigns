<p class="note ysrtech-ec-lede"><?php echo $this->escapeHtml($this->__('Looking for the Sender Check? It is in the settings now:')) ?> <a href="<?php echo $this->getUrl('adminhtml/system_config/edit', ['section' => 'ysrtech_emailcampaigns']) ?>"><?php echo $this->escapeHtml($this->__('Email Campaigns > Settings > Sender Check')) ?></a></p>

<script type="text/javascript">
//<![CDATA[
(function () {
    // Hover readout for the period chart: the day under the pointer, with
    // each series' figure for it.
    var wrap = document.getElementById('ysrtech-ec-chart');
    if (!wrap) { return; }
    var data = <?php echo Mage::helper('core')->jsonEncode($chart['data']) ?>;
    var labels = <?php echo Mage::helper('core')->jsonEncode($labels) ?>;
    var colors = <?php echo Mage::helper('core')->jsonEncode($this::COLORS) ?>;
    var svg = wrap.getElementsByTagName('svg')[0];
    var cross = svg.querySelector('.cross');
    var tip = wrap.querySelector('.ysrtech-ec-tip');
    var n = data.days.length;
    var fmt = function (v) { return String(v).replace(/\B(?=(\d{3})+(?!\d))/g, ','); };

    svg.addEventListener('mousemove', function (e) {
        var box = svg.getBoundingClientRect();
        var x = (e.clientX - box.left) * data.width / box.width;
        var i = n > 1 ? Math.round((x - data.left) / (data.plotW / (n - 1))) : 0;
        i = Math.max(0, Math.min(n - 1, i));
        var cx = data.left + (n > 1 ? i * data.plotW / (n - 1) : data.plotW / 2);
        cross.setAttribute('x1', cx); cross.setAttribute('x2', cx); cross.style.display = '';
        while (tip.firstChild) { tip.removeChild(tip.firstChild); }
        var head = document.createElement('strong');
        head.appendChild(document.createTextNode(data.days[i].label));
        tip.appendChild(head);
        for (var key in labels) {
            if (!labels.hasOwnProperty(key)) { continue; }
            var row = document.createElement('div');
            var dot = document.createElement('i'); dot.style.background = colors[key];
            row.appendChild(dot);
            row.appendChild(document.createTextNode(labels[key] + ': ' + fmt(data.days[i][key])));
            tip.appendChild(row);
        }
        tip.style.display = '';
        var px = cx * box.width / data.width;
        tip.style.left = (px > box.width / 2 ? px - tip.offsetWidth - 12 : px + 12) + 'px';
    });
    svg.addEventListener('mouseleave', function () { cross.style.display = 'none'; tip.style.display = 'none'; });
})();
//]]>
</script>
