<?php
/** @var YSRTech_EmailCampaigns_Block_Adminhtml_Campaign_Cards $this */
$collection = $this->getCollection();
$pages      = (int) $collection->getLastPageNumber();
$page       = (int) $collection->getCurPage();
$counts     = $this->getCounts();
$stats      = $this->getStats();
$pct        = static fn (int $part, int $whole) => $whole ? round($part / $whole * 100, 1) . '%' : "\u{2013}";
?>
<div class="ecg">
    <div class="eg-head">
        <h1><?php echo $this->escapeHtml($this->__('Campaigns')) ?></h1>
        <span class="spacer"></span>
        <a class="eg-btn primary" href="<?php echo $this->getUrl('*/*/new') ?>"><?php echo $this->escapeHtml($this->__('New Campaign')) ?></a>
    </div>

    <div class="tg-tools">
        <div class="tg-cats">
            <?php foreach ($this->getFilters() as $code => $label): ?>
                <a href="<?php echo $this->getPageUrl(1, $code) ?>" class="<?php echo $code === $this->getFilter() ? 'on' : '' ?>"><?php echo $this->escapeHtml($label) ?> <span><?php echo (int) $counts[$code] ?></span></a>
            <?php endforeach ?>
        </div>
        <div class="eg-seg" role="group" aria-label="<?php echo $this->escapeHtml($this->__('View')) ?>">
            <a href="<?php echo $this->getViewUrl(['view' => null]) ?>" class="<?php echo $this->getView() === 'cards' ? 'on' : '' ?>"><?php echo $this->escapeHtml($this->__('Cards')) ?></a>
            <a href="<?php echo $this->getViewUrl(['view' => 'calendar']) ?>" class="<?php echo $this->getView() === 'calendar' ? 'on' : '' ?>"><?php echo $this->escapeHtml($this->__('Calendar')) ?></a>
        </div>
        <form class="tg-search" method="get" action="<?php echo $this->getViewUrl(['q' => null]) ?>">
            <input type="search" name="q" value="<?php echo $this->escapeHtml($this->getSearch()) ?>" placeholder="<?php echo $this->escapeHtml($this->__('Search campaigns')) ?>" aria-label="<?php echo $this->escapeHtml($this->__('Search campaigns')) ?>"/>
        </form>
    </div>

    <?php if ($this->getView() === 'calendar'): ?>
        <?php
        $calendar = $this->getCalendar();
        $month    = $this->getMonth();
        ?>
        <div class="cal-head">
            <a class="eg-btn sm" href="<?php echo $this->getViewUrl(['m' => $month->modify('-1 month')->format('Y-m')]) ?>" title="<?php echo $this->escapeHtml($this->__('Previous month')) ?>">&larr;</a>
            <?php /* Straight to any month of any year, without stepping there */ ?>
            <span class="cal-pick" data-url="<?php echo $this->escapeHtml($this->getViewUrl(['m' => '0000-00'])) ?>">
                <select id="ysrtech-ec-cal-month" aria-label="<?php echo $this->escapeHtml($this->__('Month')) ?>">
                    <?php foreach ($this->getMonthNames() as $number => $name): ?>
                        <option value="<?php echo sprintf('%02d', $number) ?>"<?php if ($number === (int) $month->format('n')): ?> selected="selected"<?php endif ?>><?php echo $this->escapeHtml($name) ?></option>
                    <?php endforeach ?>
                </select>
                <select id="ysrtech-ec-cal-year" aria-label="<?php echo $this->escapeHtml($this->__('Year')) ?>">
                    <?php foreach ($this->getYears() as $year): ?>
                        <option value="<?php echo $year ?>"<?php if ($year === (int) $month->format('Y')): ?> selected="selected"<?php endif ?>><?php echo $year ?></option>
                    <?php endforeach ?>
                </select>
            </span>
            <a class="eg-btn sm" href="<?php echo $this->getViewUrl(['m' => $month->modify('+1 month')->format('Y-m')]) ?>" title="<?php echo $this->escapeHtml($this->__('Next month')) ?>">&rarr;</a>
            <a class="eg-btn sm" href="<?php echo $this->getViewUrl(['m' => null]) ?>"><?php echo $this->escapeHtml($this->__('Today')) ?></a>
            <span class="cal-note">
                <?php echo $this->escapeHtml($this->__('%d campaign(s) this month.', $calendar['count'])) ?>
                <?php if ($counts['draft'] > 0 && in_array($this->getFilter(), ['', 'draft'], true)): ?>
                    <?php echo $this->escapeHtml($this->__('Drafts have no date yet, so they are not on the calendar:')) ?>
                    <a href="<?php echo $this->getViewUrl(['view' => null, 'status' => 'draft']) ?>"><?php echo $this->escapeHtml($this->__('%d draft(s)', $counts['draft'])) ?></a>
                <?php endif ?>
            </span>
        </div>
        <table class="cal" cellspacing="0">
            <thead>
                <tr><?php foreach ($calendar['weekdays'] as $weekday): ?><th><?php echo $this->escapeHtml($weekday) ?></th><?php endforeach ?></tr>
            </thead>
            <tbody>
            <?php foreach ($calendar['weeks'] as $week): ?>
                <tr>
                <?php foreach ($week as $day): ?>
                    <td class="<?php echo $day['in'] ? '' : 'out' ?><?php echo $day['today'] ? ' today' : '' ?>">
                        <span class="cal-day"><?php echo (int) $day['date']->format('j') ?></span>
                        <?php foreach ($day['items'] as $item): ?>
                            <a class="cal-item <?php echo $this->escapeHtml($item['status']) ?>" href="<?php echo $this->getUrl('*/*/edit', ['id' => $item['id']]) ?>" title="<?php echo $this->escapeHtml($item['name'] . ' · ' . $this->getStatusLabel($item['status']) . ' · ' . $item['time']) ?>">
                                <span class="cal-time"><?php echo $this->escapeHtml($item['time']) ?></span>
                                <span class="cal-name"><?php echo $this->escapeHtml($item['name']) ?></span>
                            </a>
                        <?php endforeach ?>
                    </td>
                <?php endforeach ?>
                </tr>
            <?php endforeach ?>
            </tbody>
        </table>
        <div class="cal-legend">
            <?php foreach (['scheduled', 'sending', 'sent', 'paused', 'failed'] as $status): ?>
                <span class="eg-chip <?php echo $status ?>"><?php echo $this->escapeHtml($this->getStatusLabel($status)) ?></span>
            <?php endforeach ?>
        </div>
    <?php else: ?>
    <div class="tg-grid cg-grid">
        <?php if (!$collection->getSize()): ?>
            <div class="tg-empty">
                <?php if ($this->getSearch() !== '' || $this->getFilter() !== ''): ?>
                    <?php echo $this->escapeHtml($this->__('No campaign matches.')) ?><br/>
                    <a class="eg-btn sm" href="<?php echo $this->getUrl('*/*/index') ?>"><?php echo $this->escapeHtml($this->__('Show all')) ?></a>
                <?php else: ?>
                    <?php echo $this->escapeHtml($this->__('No campaigns yet.')) ?><br/>
                    <a class="eg-btn primary" href="<?php echo $this->getUrl('*/*/new') ?>"><?php echo $this->escapeHtml($this->__('Create the first one')) ?></a>
                <?php endif ?>
            </div>
        <?php endif ?>
        <?php foreach ($collection as $campaign): ?>
            <?php
            $open   = $this->getUrl('*/*/edit', ['id' => $campaign->getId()]);
            $html   = $this->getPreviewHtml($campaign);
            $status = (string) $campaign->getStatus();
            $s      = $stats[(int) $campaign->getId()] ?? ['sent' => (int) $campaign->getData('stat_sent'), 'opened' => 0, 'clicked' => 0];
            $when   = $status === 'scheduled' && $campaign->getScheduledAt()
                ? $this->__('Goes out %s', $this->formatDate($campaign->getScheduledAt(), 'medium', true))
                : ($campaign->getSentAt()
                    ? $this->__('Sent %s', $this->formatDate($campaign->getSentAt(), 'medium', true))
                    : $this->__('Edited %s', $this->formatDate($campaign->getUpdatedAt() ?: $campaign->getCreatedAt(), 'medium')));
            ?>
            <a class="tg-card cg-card" href="<?php echo $open ?>">
                <span class="tg-thumb<?php echo $html === '' ? ' empty' : '' ?>">
                    <?php if ($html !== ''): ?>
                        <iframe sandbox="" scrolling="no" tabindex="-1" loading="lazy" title="<?php echo $this->escapeHtml($campaign->getName()) ?>" srcdoc="<?php echo $this->escapeHtml($html) ?>"></iframe>
                    <?php else: ?>
                        <?php echo $this->escapeHtml($this->__('No email yet')) ?>
                    <?php endif ?>
                </span>
                <span class="tg-info">
                    <span class="cg-top">
                        <b title="<?php echo $this->escapeHtml($campaign->getName()) ?>"><?php echo $this->escapeHtml($campaign->getName()) ?></b>
                        <span class="eg-chip <?php echo $this->escapeHtml($status) ?>"><?php echo $this->escapeHtml($this->getStatusLabel($status)) ?></span>
                    </span>
                    <small class="line"><?php echo $this->escapeHtml($campaign->getSubject() ?: $this->__('No subject yet')) ?></small>
                    <small><?php echo $this->escapeHtml($when) ?></small>
                    <?php if ($s['sent'] > 0): ?>
                        <span class="tg-stats">
                            <span><b><?php echo number_format($s['sent']) ?></b> <?php echo $this->escapeHtml($this->__('sent')) ?></span>
                            <span><b><?php echo $pct($s['opened'], $s['sent']) ?></b> <?php echo $this->escapeHtml($this->__('opened')) ?></span>
                            <span><b><?php echo $pct($s['clicked'], $s['sent']) ?></b> <?php echo $this->escapeHtml($this->__('clicked')) ?></span>
                        </span>
                    <?php endif ?>
                </span>
            </a>
        <?php endforeach ?>
    </div>

    <?php if ($pages > 1): ?>
        <div class="eg-pages">
            <?php if ($page > 1): ?><a class="eg-btn sm" href="<?php echo $this->getPageUrl($page - 1) ?>">&larr; <?php echo $this->escapeHtml($this->__('Newer')) ?></a><?php endif ?>
            <span><?php echo $this->escapeHtml($this->__('Page %d of %d', $page, $pages)) ?></span>
            <?php if ($page < $pages): ?><a class="eg-btn sm" href="<?php echo $this->getPageUrl($page + 1) ?>"><?php echo $this->escapeHtml($this->__('Older')) ?> &rarr;</a><?php endif ?>
        </div>
    <?php endif ?>
    <?php endif ?>
</div>
<script type="text/javascript">
//<![CDATA[
(function () {
    var pick = document.querySelector('.ecg .cal-pick');
    if (pick) {
        var go = function () {
            window.location.href = pick.getAttribute('data-url').replace('0000-00',
                document.getElementById('ysrtech-ec-cal-year').value + '-' + document.getElementById('ysrtech-ec-cal-month').value);
        };
        document.getElementById('ysrtech-ec-cal-month').addEventListener('change', go);
        document.getElementById('ysrtech-ec-cal-year').addEventListener('change', go);
    }

    var fit = function () {
        Array.prototype.forEach.call(document.querySelectorAll('.ecg .tg-thumb iframe'), function (frame) {
            frame.style.transform = 'scale(' + (frame.parentNode.clientWidth / 680) + ')';
        });
    };
    fit();
    window.addEventListener('resize', fit);
})();
//]]>
</script>
