<?xml version="1.0"?>
<!--
/**
 * YSRTech EmailCampaigns - admin layout.
 *
 * @category  YSRTech
 * @package   YSRTech_EmailCampaigns
 */
-->
<layout>
    <!--
        The segment editor is built on Mage_Rule, whose condition tree is driven
        by VarienRulesForm in mage/adminhtml/rules.js. That file is added by the
        core "main" layout only where this flag is set, so without it the
        conditions fieldset renders and then does nothing.
    -->
    <adminhtml_ysrtech_segment_new>
        <reference name="head">
            <action method="setCanLoadRulesJs"><flag>1</flag></action>
            <block type="ysrtech_emailcampaigns/adminhtml_assets" name="ysrtech.ec.assets.1">
                <action method="addJs"><name>ysrtech/emailcampaigns/segment-preview.js</name></action>
                <action method="addCss"><name>ysrtech/emailcampaigns/admin.css</name></action>
            </block>
        </reference>
    </adminhtml_ysrtech_segment_new>

    <adminhtml_ysrtech_segment_edit>
        <reference name="head">
            <action method="setCanLoadRulesJs"><flag>1</flag></action>
            <block type="ysrtech_emailcampaigns/adminhtml_assets" name="ysrtech.ec.assets.2">
                <action method="addJs"><name>ysrtech/emailcampaigns/segment-preview.js</name></action>
                <action method="addCss"><name>ysrtech/emailcampaigns/admin.css</name></action>
            </block>
        </reference>
    </adminhtml_ysrtech_segment_edit>

    <!--
        One small stylesheet for the pages that draw something the admin theme
        has no widget for: the dashboard tiles and charts, the reason counts
        above the suppression grid, the import steps.
    -->
    <ysrtech_emailcampaigns_admin_css>
        <reference name="head">
            <block type="ysrtech_emailcampaigns/adminhtml_assets" name="ysrtech.ec.assets.3">
                <action method="addCss"><name>ysrtech/emailcampaigns/admin.css</name></action>
            </block>
        </reference>
    </ysrtech_emailcampaigns_admin_css>

    <adminhtml_ysrtech_dashboard_index>
        <update handle="ysrtech_emailcampaigns_admin_css"/>
    </adminhtml_ysrtech_dashboard_index>

    <adminhtml_ysrtech_segment_view>
        <update handle="ysrtech_emailcampaigns_admin_css"/>
    </adminhtml_ysrtech_segment_view>

    <adminhtml_ysrtech_suppression_index>
        <update handle="ysrtech_emailcampaigns_admin_css"/>
    </adminhtml_ysrtech_suppression_index>

    <adminhtml_ysrtech_import_index>
        <update handle="ysrtech_emailcampaigns_admin_css"/>
    </adminhtml_ysrtech_import_index>

    <adminhtml_ysrtech_import_view>
        <update handle="ysrtech_emailcampaigns_admin_css"/>
    </adminhtml_ysrtech_import_view>

    <adminhtml_ysrtech_import_new>
        <update handle="ysrtech_emailcampaigns_admin_css"/>
    </adminhtml_ysrtech_import_new>

    <adminhtml_ysrtech_import_map>
        <update handle="ysrtech_emailcampaigns_admin_css"/>
    </adminhtml_ysrtech_import_map>

    <adminhtml_ysrtech_import_provider>
        <update handle="ysrtech_emailcampaigns_admin_css"/>
    </adminhtml_ysrtech_import_provider>

    <!-- The card lists: templates, the starter gallery, campaigns -->
    <ysrtech_emailcampaigns_cards_css>
        <reference name="head">
            <block type="ysrtech_emailcampaigns/adminhtml_assets" name="ysrtech.ec.assets.4">
                <action method="addCss"><name>ysrtech/emailcampaigns/cards.css</name></action>
            </block>
        </reference>
    </ysrtech_emailcampaigns_cards_css>

    <adminhtml_ysrtech_subscriber_view>
        <update handle="ysrtech_emailcampaigns_cards_css"/>
    </adminhtml_ysrtech_subscriber_view>

    <!--
        The built-in subscriber list is still reachable from old links; it
        lights up Email Campaigns > Subscribers rather than a menu that is gone.
    -->
    <adminhtml_newsletter_subscriber_index>
        <reference name="menu">
            <action method="setActive"><path>ysrtech_emailcampaigns/subscriber</path></action>
        </reference>
    </adminhtml_newsletter_subscriber_index>

    <adminhtml_ysrtech_template_new>
        <update handle="ysrtech_emailcampaigns_cards_css"/>
    </adminhtml_ysrtech_template_new>

    <adminhtml_ysrtech_template_index>
        <update handle="ysrtech_emailcampaigns_cards_css"/>
    </adminhtml_ysrtech_template_index>

    <adminhtml_ysrtech_automation_index>
        <update handle="ysrtech_emailcampaigns_cards_css"/>
    </adminhtml_ysrtech_automation_index>

    <adminhtml_ysrtech_campaign_index>
        <update handle="ysrtech_emailcampaigns_cards_css"/>
    </adminhtml_ysrtech_campaign_index>

    <adminhtml_ysrtech_campaign_edit>
        <update handle="ysrtech_emailcampaigns_admin_css"/>
    </adminhtml_ysrtech_campaign_edit>
</layout>
