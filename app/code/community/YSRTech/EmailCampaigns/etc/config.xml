<?xml version="1.0"?>
<config>
    <modules>
        <YSRTech_EmailCampaigns>
            <version>0.21.1</version>
        </YSRTech_EmailCampaigns>
    </modules>

    <global>
        <models>
            <ysrtech_emailcampaigns>
                <class>YSRTech_EmailCampaigns_Model</class>
                <resourceModel>ysrtech_emailcampaigns_resource</resourceModel>
            </ysrtech_emailcampaigns>
            <ysrtech_emailcampaigns_resource>
                <class>YSRTech_EmailCampaigns_Model_Resource</class>
                <entities>
                    <template>
                        <table>ysrtech_emailcampaigns_template</table>
                    </template>
                    <segment>
                        <table>ysrtech_emailcampaigns_segment</table>
                    </segment>
                    <segment_subscriber>
                        <table>ysrtech_emailcampaigns_segment_subscriber</table>
                    </segment_subscriber>
                    <campaign_segment>
                        <table>ysrtech_emailcampaigns_campaign_segment</table>
                    </campaign_segment>
                    <automation>
                        <table>ysrtech_emailcampaigns_automation</table>
                    </automation>
                    <automation_step>
                        <table>ysrtech_emailcampaigns_automation_step</table>
                    </automation_step>
                    <!-- Kept declared so the 0.1.0 install script and the
                         upgrade that drops it can still resolve the name. -->
                    <segment_customer>
                        <table>ysrtech_emailcampaigns_segment_customer</table>
                    </segment_customer>
                    <campaign>
                        <table>ysrtech_emailcampaigns_campaign</table>
                    </campaign>
                    <queue>
                        <table>ysrtech_emailcampaigns_queue</table>
                    </queue>
                    <subscriber_pref>
                        <table>ysrtech_emailcampaigns_subscriber_preference</table>
                    </subscriber_pref>
                    <suppression>
                        <table>ysrtech_emailcampaigns_suppression</table>
                    </suppression>
                    <ai_usage>
                        <table>ysrtech_emailcampaigns_ai_usage</table>
                    </ai_usage>
                    <webhook_event>
                        <table>ysrtech_emailcampaigns_webhook_event</table>
                    </webhook_event>
                    <import>
                        <table>ysrtech_emailcampaigns_import</table>
                    </import>
                    <section>
                        <table>ysrtech_emailcampaigns_section</table>
                    </section>
                    <import_seen>
                        <table>ysrtech_emailcampaigns_import_seen</table>
                    </import_seen>
                </entities>
            </ysrtech_emailcampaigns_resource>
        </models>

        <blocks>
            <ysrtech_emailcampaigns>
                <class>YSRTech_EmailCampaigns_Block</class>
            </ysrtech_emailcampaigns>
        </blocks>

        <helpers>
            <ysrtech_emailcampaigns>
                <class>YSRTech_EmailCampaigns_Helper</class>
            </ysrtech_emailcampaigns>
        </helpers>

        <resources>
            <ysrtech_emailcampaigns_setup>
                <setup>
                    <module>YSRTech_EmailCampaigns</module>
                </setup>
            </ysrtech_emailcampaigns_setup>
        </resources>

        <events>
            <!-- Recalculate segment membership nightly -->
            <sales_order_place_after>
                <observers>
                    <ysrtech_emailcampaigns_order_placed>
                        <class>ysrtech_emailcampaigns/observer</class>
                        <method>orderPlaced</method>
                    </ysrtech_emailcampaigns_order_placed>
                </observers>
            </sales_order_place_after>
            <!--
                save_commit_after, not save_after: the latter can fire inside a
                transaction that later rolls back, which would mail somebody
                about an order that no longer exists.
            -->
            <sales_order_save_commit_after>
                <observers>
                    <ysrtech_emailcampaigns_order_status>
                        <class>ysrtech_emailcampaigns/observer</class>
                        <method>orderStatusChanged</method>
                    </ysrtech_emailcampaigns_order_status>
                </observers>
            </sales_order_save_commit_after>
            <sales_order_shipment_save_commit_after>
                <observers>
                    <ysrtech_emailcampaigns_shipment>
                        <class>ysrtech_emailcampaigns/observer</class>
                        <method>orderDocumentCreated</method>
                    </ysrtech_emailcampaigns_shipment>
                </observers>
            </sales_order_shipment_save_commit_after>
            <sales_order_invoice_save_commit_after>
                <observers>
                    <ysrtech_emailcampaigns_invoice>
                        <class>ysrtech_emailcampaigns/observer</class>
                        <method>orderDocumentCreated</method>
                    </ysrtech_emailcampaigns_invoice>
                </observers>
            </sales_order_invoice_save_commit_after>
            <sales_order_creditmemo_save_commit_after>
                <observers>
                    <ysrtech_emailcampaigns_creditmemo>
                        <class>ysrtech_emailcampaigns/observer</class>
                        <method>orderDocumentCreated</method>
                    </ysrtech_emailcampaigns_creditmemo>
                </observers>
            </sales_order_creditmemo_save_commit_after>
            <ysrtech_emailcampaigns_reindex_segments>
                <observers>
                    <ysrtech_emailcampaigns_reindex>
                        <class>ysrtech_emailcampaigns/observer</class>
                        <method>reindexSegments</method>
                    </ysrtech_emailcampaigns_reindex>
                </observers>
            </ysrtech_emailcampaigns_reindex_segments>
        </events>
    </global>

    <frontend>
        <routers>
            <ysrtech_emailcampaigns>
                <use>standard</use>
                <args>
                    <module>YSRTech_EmailCampaigns</module>
                    <frontName>emailcampaigns</frontName>
                </args>
            </ysrtech_emailcampaigns>
        </routers>
        <translate>
            <modules>
                <YSRTech_EmailCampaigns>
                    <files>
                        <default>YSRTech_EmailCampaigns.csv</default>
                    </files>
                </YSRTech_EmailCampaigns>
            </modules>
        </translate>
    </frontend>

    <admin>
        <routers>
            <adminhtml>
                <args>
                    <modules>
                        <YSRTech_EmailCampaigns before="Mage_Adminhtml">YSRTech_EmailCampaigns_Adminhtml</YSRTech_EmailCampaigns>
                    </modules>
                </args>
            </adminhtml>
        </routers>
    </admin>

    <adminhtml>
        <events>
            <controller_action_predispatch_adminhtml>
                <observers>
                    <ysrtech_emailcampaigns_old_newsletter_pages>
                        <class>ysrtech_emailcampaigns/observer</class>
                        <method>closeOldNewsletterPages</method>
                    </ysrtech_emailcampaigns_old_newsletter_pages>
                </observers>
            </controller_action_predispatch_adminhtml>
        </events>
        <layout>
            <updates>
                <ysrtech_emailcampaigns>
                    <file>ysrtech_emailcampaigns.xml</file>
                </ysrtech_emailcampaigns>
            </updates>
        </layout>

        <!--
            Every child here has an ACL node of the same name below. The menu
            checks admin/<path> for each entry, and a path with no node is
            refused outright, so an entry without one shows for a superadmin
            and for nobody else.
        -->
        <menu>
            <!--
                The built-in Newsletter menu goes: its subscribers are listed
                under Email Campaigns, and its templates, queue and problem
                reports are the older way of doing what this module does.
            -->
            <newsletter>
                <disabled>1</disabled>
            </newsletter>
            <ysrtech_emailcampaigns translate="title" module="ysrtech_emailcampaigns">
                <title>Email Campaigns</title>
                <sort_order>75</sort_order>
                <children>
                    <dashboard translate="title" module="ysrtech_emailcampaigns">
                        <title>Dashboard</title>
                        <action>adminhtml/ysrtech_dashboard/index</action>
                        <sort_order>10</sort_order>
                    </dashboard>
                    <subscriber translate="title" module="ysrtech_emailcampaigns">
                        <title>Subscribers</title>
                        <action>adminhtml/ysrtech_subscriber/index</action>
                        <sort_order>15</sort_order>
                    </subscriber>
                    <segment translate="title" module="ysrtech_emailcampaigns">
                        <title>Segments</title>
                        <action>adminhtml/ysrtech_segment/index</action>
                        <sort_order>20</sort_order>
                    </segment>
                    <campaign translate="title" module="ysrtech_emailcampaigns">
                        <title>Campaigns</title>
                        <action>adminhtml/ysrtech_campaign/index</action>
                        <sort_order>30</sort_order>
                    </campaign>
                    <template translate="title" module="ysrtech_emailcampaigns">
                        <title>Templates</title>
                        <action>adminhtml/ysrtech_template/index</action>
                        <sort_order>40</sort_order>
                    </template>
                    <automation translate="title" module="ysrtech_emailcampaigns">
                        <title>Automations</title>
                        <action>adminhtml/ysrtech_automation/index</action>
                        <sort_order>50</sort_order>
                    </automation>
                    <suppression translate="title" module="ysrtech_emailcampaigns">
                        <title>Suppressions</title>
                        <action>adminhtml/ysrtech_suppression/index</action>
                        <sort_order>60</sort_order>
                    </suppression>
                    <import translate="title" module="ysrtech_emailcampaigns">
                        <title>Import / Migrate</title>
                        <action>adminhtml/ysrtech_import/index</action>
                        <sort_order>70</sort_order>
                    </import>
                    <config translate="title" module="ysrtech_emailcampaigns">
                        <title>Settings</title>
                        <action>adminhtml/system_config/edit/section/ysrtech_emailcampaigns</action>
                        <sort_order>80</sort_order>
                    </config>
                </children>
            </ysrtech_emailcampaigns>
        </menu>
        <acl>
            <resources>
                <all>
                    <title>Allow Everything</title>
                </all>
                <admin>
                    <children>
                        <!--
                            A role that was granted "Email Campaigns" before
                            these children existed keeps all of them: a
                            resource with no rule of its own inherits its
                            parent's.
                        -->
                        <ysrtech_emailcampaigns translate="title" module="ysrtech_emailcampaigns">
                            <title>Email Campaigns</title>
                            <sort_order>75</sort_order>
                            <children>
                                <dashboard translate="title" module="ysrtech_emailcampaigns">
                                    <title>Dashboard</title>
                                    <sort_order>10</sort_order>
                                </dashboard>
                                <subscriber translate="title" module="ysrtech_emailcampaigns">
                                    <title>Subscribers</title>
                                    <sort_order>15</sort_order>
                                </subscriber>
                                <segment translate="title" module="ysrtech_emailcampaigns">
                                    <title>Segments</title>
                                    <sort_order>20</sort_order>
                                </segment>
                                <campaign translate="title" module="ysrtech_emailcampaigns">
                                    <title>Campaigns</title>
                                    <sort_order>30</sort_order>
                                </campaign>
                                <template translate="title" module="ysrtech_emailcampaigns">
                                    <title>Templates</title>
                                    <sort_order>40</sort_order>
                                </template>
                                <automation translate="title" module="ysrtech_emailcampaigns">
                                    <title>Automations</title>
                                    <sort_order>50</sort_order>
                                </automation>
                                <suppression translate="title" module="ysrtech_emailcampaigns">
                                    <title>Suppressions</title>
                                    <sort_order>60</sort_order>
                                    <children>
                                        <!-- Mailing somebody who reported
                                             spam is the costliest mistake on
                                             this page, so lifting a complaint
                                             is its own permission. -->
                                        <remove_complaint translate="title" module="ysrtech_emailcampaigns">
                                            <title>Remove Spam Complaints</title>
                                            <sort_order>10</sort_order>
                                        </remove_complaint>
                                    </children>
                                </suppression>
                                <import translate="title" module="ysrtech_emailcampaigns">
                                    <title>Import / Migrate</title>
                                    <sort_order>70</sort_order>
                                </import>
                                <!-- The Settings shortcut. Opening the page it
                                     links to still needs the System >
                                     Configuration node below. -->
                                <config translate="title" module="ysrtech_emailcampaigns">
                                    <title>Settings (menu shortcut)</title>
                                    <sort_order>80</sort_order>
                                </config>
                            </children>
                        </ysrtech_emailcampaigns>
                        <system>
                            <children>
                                <config>
                                    <children>
                                        <ysrtech_emailcampaigns translate="title">
                                            <title>Email Campaigns Section</title>
                                        </ysrtech_emailcampaigns>
                                    </children>
                                </config>
                            </children>
                        </system>
                    </children>
                </admin>
            </resources>
        </acl>
    </adminhtml>

    <default>
        <ysrtech_emailcampaigns>
            <sending>
                <transport>smtp</transport>
                <mailgun_region>us</mailgun_region>
                <batch_size>500</batch_size>
                <max_per_minute>1000</max_per_minute>
                <max_attempts>3</max_attempts>
            </sending>
            <brand>
                <enabled>1</enabled>
                <logo_width>180</logo_width>
                <button_color>#1f4e79</button_color>
                <button_text_color>#ffffff</button_text_color>
                <heading_color>#222222</heading_color>
                <text_color>#444444</text_color>
                <link_color>#1f4e79</link_color>
                <page_bg>#f4f4f4</page_bg>
                <content_bg>#ffffff</content_bg>
                <font>Arial,Helvetica,sans-serif</font>
            </brand>
            <cleanup>
                <enabled>1</enabled>
                <keep_days>90</keep_days>
            </cleanup>
            <tracking>
                <enabled>1</enabled>
            </tracking>
            <ai>
                <enabled>0</enabled>
                <provider>openrouter</provider>
                <max_calls_per_hour>60</max_calls_per_hour>
            </ai>
        </ysrtech_emailcampaigns>
    </default>

    <crontab>
        <jobs>
            <!-- Every minute; how much goes out per run is the Maximum Per
                 Minute setting, not how often this fires. -->
            <ysrtech_emailcampaigns_process_queue>
                <schedule><cron_expr>* * * * *</cron_expr></schedule>
                <run><model>ysrtech_emailcampaigns/observer::processQueue</model></run>
            </ysrtech_emailcampaigns_process_queue>
            <!-- Apply the webhooks kept since the last run -->
            <ysrtech_emailcampaigns_process_webhooks>
                <schedule><cron_expr>* * * * *</cron_expr></schedule>
                <run><model>ysrtech_emailcampaigns/observer::processWebhooks</model></run>
            </ysrtech_emailcampaigns_process_webhooks>
            <ysrtech_emailcampaigns_send_scheduled>
                <schedule><cron_expr>* * * * *</cron_expr></schedule>
                <run><model>ysrtech_emailcampaigns/observer::launchScheduledCampaigns</model></run>
            </ysrtech_emailcampaigns_send_scheduled>
            <ysrtech_emailcampaigns_reindex_segments>
                <schedule><cron_expr>0 2 * * *</cron_expr></schedule>
                <run><model>ysrtech_emailcampaigns/observer::reindexSegments</model></run>
            </ysrtech_emailcampaigns_reindex_segments>
            <!-- Pull back who unsubscribed, bounced or complained on Mailgun -->
            <ysrtech_emailcampaigns_abandoned_carts>
                <schedule><cron_expr>*/15 * * * *</cron_expr></schedule>
                <run><model>ysrtech_emailcampaigns/observer::processAbandonedCarts</model></run>
            </ysrtech_emailcampaigns_abandoned_carts>
            <ysrtech_emailcampaigns_queue_cleanup>
                <schedule><cron_expr>40 3 * * *</cron_expr></schedule>
                <run><model>ysrtech_emailcampaigns/observer::cleanupQueue</model></run>
            </ysrtech_emailcampaigns_queue_cleanup>
            <!-- Imports and provider migrations, a batch at a time -->
            <ysrtech_emailcampaigns_process_imports>
                <schedule><cron_expr>* * * * *</cron_expr></schedule>
                <run><model>ysrtech_emailcampaigns/observer::processImports</model></run>
            </ysrtech_emailcampaigns_process_imports>
            <ysrtech_emailcampaigns_sync_suppressions>
                <schedule><cron_expr>15 * * * *</cron_expr></schedule>
                <run><model>ysrtech_emailcampaigns/observer::syncSuppressions</model></run>
            </ysrtech_emailcampaigns_sync_suppressions>
        </jobs>
    </crontab>
</config>
