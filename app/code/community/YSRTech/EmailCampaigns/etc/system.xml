<?xml version="1.0"?>
<config>
    <tabs>
        <ysrtech translate="label" module="ysrtech_emailcampaigns">
            <label>YSRTech</label>
            <sort_order>300</sort_order>
        </ysrtech>
    </tabs>
    <sections>
        <ysrtech_emailcampaigns translate="label" module="ysrtech_emailcampaigns">
            <label>Email Campaigns</label>
            <tab>ysrtech</tab>
            <sort_order>100</sort_order>
            <show_in_default>1</show_in_default>
            <show_in_website>1</show_in_website>
            <show_in_store>1</show_in_store>
            <groups>
                <sending translate="label">
                    <label>Sending</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>10</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <fields>
                        <transport translate="label">
                            <label>Transport Provider</label>
                            <frontend_type>select</frontend_type>
                            <source_model>ysrtech_emailcampaigns/system_config_source_transport</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                        </transport>
                        <api_key translate="label comment">
                            <label>Provider API Key</label>
                            <frontend_type>obscure</frontend_type>
                            <backend_model>adminhtml/system_config_backend_encrypted</backend_model>
                            <comment>Used to send. A Mailgun domain sending key is enough and is what Mailgun recommends here, since it can do nothing but send from one domain.</comment>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                        </api_key>
                        <mailgun_region translate="label comment">
                            <label>Mailgun Region</label>
                            <frontend_type>select</frontend_type>
                            <source_model>ysrtech_emailcampaigns/system_config_source_mailgun_region</source_model>
                            <comment>Where the Mailgun domain was created. A domain exists in one region only, and the other region answers as though it did not exist at all, so a wrong choice here reads as a wrong domain.</comment>
                            <sort_order>21</sort_order>
                            <show_in_default>1</show_in_default>
                            <depends><transport>mailgun</transport></depends>
                        </mailgun_region>
                        <mailgun_domain translate="label comment">
                            <label>Mailgun Sending Domain</label>
                            <frontend_type>text</frontend_type>
                            <comment>The domain campaigns are sent from, e.g. mg-news.example.com. Use a subdomain kept separate from the one that sends order emails: a campaign that trips spam filters must not take receipts down with it.</comment>
                            <sort_order>22</sort_order>
                            <!-- Global, like the api key and the from address
                                 beside it: one Mailgun account sends for the
                                 whole store, and a per-website domain here
                                 would not match the key it is used with. -->
                            <show_in_default>1</show_in_default>
                            <depends><transport>mailgun</transport></depends>
                        </mailgun_domain>
                        <suppression_api_key translate="label comment">
                            <label>Suppression API Key (Mailgun)</label>
                            <frontend_type>obscure</frontend_type>
                            <backend_model>adminhtml/system_config_backend_encrypted</backend_model>
                            <comment><![CDATA[Used only by the hourly job that reads unsubscribes, bounces and complaints back from Mailgun. Those lists sit outside a sending key's scope, so that key answers 401 here and needs an account key, or a role key with suppression permissions. Keeping it separate means the key that sends - the one in the request on every campaign - does not have to be the account-wide one. Leave blank to use the sending key above.]]></comment>
                            <sort_order>23</sort_order>
                            <show_in_default>1</show_in_default>
                            <depends><transport>mailgun</transport></depends>
                        </suppression_api_key>
                        <mailgun_webhook_signing_key translate="label comment">
                            <label>Mailgun Webhook Signing Key</label>
                            <frontend_type>obscure</frontend_type>
                            <backend_model>adminhtml/system_config_backend_encrypted</backend_model>
                            <comment><![CDATA[From Mailgun's webhook settings. The endpoint below is open to the internet, so without this key every request to it is refused - which is also what happens when the key is wrong, so a webhook that silently does nothing is the first thing to check here. Webhooks report unsubscribes, complaints and hard bounces within seconds, and opens and clicks, which no suppression list carries.]]></comment>
                            <sort_order>24</sort_order>
                            <show_in_default>1</show_in_default>
                            <depends><transport>mailgun</transport></depends>
                        </mailgun_webhook_signing_key>
                        <mailgun_webhook_url translate="label comment">
                            <label>Mailgun Webhook URL</label>
                            <frontend_type>label</frontend_type>
                            <frontend_model>ysrtech_emailcampaigns/adminhtml_system_config_webhookurl</frontend_model>
                            <comment><![CDATA[Add this under Sending &gt; Webhooks for the domain, for the events Permanent Failure, Spam Complaints, Unsubscribes, Opens and Clicks.]]></comment>
                            <sort_order>25</sort_order>
                            <show_in_default>1</show_in_default>
                            <depends><transport>mailgun</transport></depends>
                        </mailgun_webhook_url>
                        <mailgun_test translate="label comment">
                            <label>Mailgun Connection</label>
                            <frontend_type>button</frontend_type>
                            <frontend_model>ysrtech_emailcampaigns/adminhtml_system_config_mailguntest</frontend_model>
                            <comment>Checks the saved keys, region and domain against Mailgun. Sends nothing. Save the configuration first: the test reads what is stored, not what is typed above.</comment>
                            <sort_order>26</sort_order>
                            <show_in_default>1</show_in_default>
                            <depends><transport>mailgun</transport></depends>
                        </mailgun_test>
                        <resend_webhook_signing_secret translate="label comment">
                            <label>Resend Webhook Signing Secret</label>
                            <frontend_type>obscure</frontend_type>
                            <backend_model>adminhtml/system_config_backend_encrypted</backend_model>
                            <comment><![CDATA[From Resend's webhook settings, in the whsec_... form. Verifies /emailcampaigns/webhook/resend, which reports bounces and complaints. Only needed when Resend is the transport.]]></comment>
                            <sort_order>28</sort_order>
                            <show_in_default>1</show_in_default>
                            <depends><transport>resend</transport></depends>
                        </resend_webhook_signing_secret>
                        <from_name translate="label">
                            <label>Default From Name</label>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                        </from_name>
                        <from_email translate="label">
                            <label>Default From Email</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>40</sort_order>
                            <show_in_default>1</show_in_default>
                        </from_email>
                        <max_per_minute translate="label comment">
                            <label>Maximum Per Minute</label>
                            <frontend_type>text</frontend_type>
                            <validate>validate-digits</validate>
                            <comment>The most messages sent in any one minute, campaigns and automations together. 1000 is 60,000 an hour. Lower it to go easier on the server or to warm up a new sending domain; 0 means no limit beyond what one cron run can do. Sending happens in the background from cron, never while a page loads.</comment>
                            <sort_order>49</sort_order>
                            <show_in_default>1</show_in_default>
                        </max_per_minute>
                        <batch_size translate="label comment">
                            <label>Batch Size</label>
                            <frontend_type>text</frontend_type>
                            <validate>validate-digits</validate>
                            <comment>How many queued messages are taken at a time. With Mailgun a batch of campaign mail is one API call, up to 500 recipients. If a call fails, this is how many wait for the retry.</comment>
                            <sort_order>50</sort_order>
                            <show_in_default>1</show_in_default>
                        </batch_size>
                        <abandoned_cart_hours translate="label comment">
                            <label>Abandoned Cart After (hours)</label>
                            <frontend_type>text</frontend_type>
                            <comment>How long a cart must sit untouched before it counts as abandoned. Too short and you nudge people who are still shopping.</comment>
                            <sort_order>55</sort_order>
                            <show_in_default>1</show_in_default>
                        </abandoned_cart_hours>
                        <max_attempts translate="label">
                            <label>Max Send Attempts</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>60</sort_order>
                            <show_in_default>1</show_in_default>
                        </max_attempts>
                    </fields>
                </sending>
                <brand translate="label comment">
                    <label>Brand: Header, Footer and Colours</label>
                    <comment><![CDATA[How every email from this store view looks: its logo, its colours, and the header and footer around the message. Applied when an email is sent, so a change here reaches every later send without editing a single template. Each store view can have its own: change the scope at the top left.]]></comment>
                    <sort_order>15</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <fields>
                        <enabled translate="label comment">
                            <label>Use a Header and Footer</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <comment>When on, new templates and campaigns are wrapped in the header and footer below, and the ready-made designs leave their own footer out. Each template and campaign can still switch it off for itself.</comment>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </enabled>
                        <logo translate="label comment">
                            <label>Logo</label>
                            <frontend_type>image</frontend_type>
                            <backend_model>adminhtml/system_config_backend_image</backend_model>
                            <upload_dir config="system/filesystem/media" scope_info="1">ysrtech/emailcampaigns/brand</upload_dir>
                            <base_url type="media" scope_info="1">ysrtech/emailcampaigns/brand</base_url>
                            <comment>PNG, JPG or GIF, at least twice the width it is shown at so it stays sharp on a phone. Without one, the store's name is written out instead.</comment>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </logo>
                        <logo_width translate="label comment">
                            <label>Logo Width (pixels)</label>
                            <frontend_type>text</frontend_type>
                            <validate>validate-digits</validate>
                            <comment>How wide the logo is shown. 180 unless set; the email itself is 600 wide.</comment>
                            <sort_order>22</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </logo_width>
                        <logo_link translate="label comment">
                            <label>Logo Links To</label>
                            <frontend_type>text</frontend_type>
                            <validate>validate-url</validate>
                            <comment>Leave empty for this store view's home page.</comment>
                            <sort_order>24</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </logo_link>
                        <header_links translate="label comment">
                            <label>Header Links</label>
                            <frontend_type>textarea</frontend_type>
                            <comment><![CDATA[One a line, as <strong>Label | https://address</strong>. Up to five, shown in a row under the logo. Leave empty for the logo alone.]]></comment>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </header_links>
                        <button_color translate="label comment">
                            <label>Button Colour</label>
                            <frontend_type>text</frontend_type>
                            <frontend_model>ysrtech_emailcampaigns/adminhtml_system_config_color</frontend_model>
                            <comment>Buttons and coupon boxes in the ready-made designs.</comment>
                            <sort_order>40</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </button_color>
                        <button_text_color translate="label">
                            <label>Button Text Colour</label>
                            <frontend_type>text</frontend_type>
                            <frontend_model>ysrtech_emailcampaigns/adminhtml_system_config_color</frontend_model>
                            <sort_order>42</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </button_text_color>
                        <heading_color translate="label">
                            <label>Heading Colour</label>
                            <frontend_type>text</frontend_type>
                            <frontend_model>ysrtech_emailcampaigns/adminhtml_system_config_color</frontend_model>
                            <sort_order>44</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </heading_color>
                        <text_color translate="label">
                            <label>Text Colour</label>
                            <frontend_type>text</frontend_type>
                            <frontend_model>ysrtech_emailcampaigns/adminhtml_system_config_color</frontend_model>
                            <sort_order>46</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </text_color>
                        <link_color translate="label">
                            <label>Link Colour</label>
                            <frontend_type>text</frontend_type>
                            <frontend_model>ysrtech_emailcampaigns/adminhtml_system_config_color</frontend_model>
                            <sort_order>48</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </link_color>
                        <page_bg translate="label comment">
                            <label>Page Background</label>
                            <frontend_type>text</frontend_type>
                            <frontend_model>ysrtech_emailcampaigns/adminhtml_system_config_color</frontend_model>
                            <comment>The colour around the email.</comment>
                            <sort_order>50</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </page_bg>
                        <content_bg translate="label comment">
                            <label>Email Background</label>
                            <frontend_type>text</frontend_type>
                            <frontend_model>ysrtech_emailcampaigns/adminhtml_system_config_color</frontend_model>
                            <comment>The colour of the email itself.</comment>
                            <sort_order>52</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </content_bg>
                        <font translate="label comment">
                            <label>Font</label>
                            <frontend_type>select</frontend_type>
                            <source_model>ysrtech_emailcampaigns/system_config_source_brand_font</source_model>
                            <comment>Only fonts every mail client already has. Anything else would be swapped for a fallback in most inboxes.</comment>
                            <sort_order>60</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </font>
                        <heading_font translate="label comment">
                            <label>Heading Font</label>
                            <frontend_type>select</frontend_type>
                            <source_model>ysrtech_emailcampaigns/system_config_source_brand_headingfont</source_model>
                            <comment>For section headings and product names in the product blocks.</comment>
                            <sort_order>62</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </heading_font>
                        <footer_links translate="label comment">
                            <label>Footer Links</label>
                            <frontend_type>textarea</frontend_type>
                            <comment><![CDATA[One a line, as <strong>Label | https://address</strong>: social pages, contact, returns. Up to eight.]]></comment>
                            <sort_order>70</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </footer_links>
                        <footer_text translate="label comment">
                            <label>Footer Small Print</label>
                            <frontend_type>textarea</frontend_type>
                            <comment>Optional. The store's name, its postal address (General &gt; Store Information) and the unsubscribe link are always in the footer.</comment>
                            <sort_order>72</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </footer_text>
                        <apply translate="label comment">
                            <label>Existing Templates and Drafts</label>
                            <frontend_type>button</frontend_type>
                            <frontend_model>ysrtech_emailcampaigns/adminhtml_system_config_brandapply</frontend_model>
                            <comment>Templates and campaigns made before this was switched on keep their own footer and do not wear the header and footer above. This switches it on for all templates and all draft campaigns, and takes their old built-in footer out so that none ends up with two. Sent campaigns are not touched. Save the configuration first.</comment>
                            <sort_order>90</sort_order>
                            <show_in_default>1</show_in_default>
                        </apply>
                    </fields>
                </brand>
                <cleanup translate="label">
                    <label>Queue Cleanup</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>20</sort_order>
                    <show_in_default>1</show_in_default>
                    <fields>
                        <enabled translate="label comment">
                            <label>Remove Finished Queue Rows</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <comment><![CDATA[A send leaves one row per recipient and the sender scans that table every five minutes, so they are not free to keep. A campaign's totals are written onto the campaign before its rows go and the analytics page reads those instead, so the figures survive the cleanup.]]></comment>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                        </enabled>
                        <keep_days translate="label comment">
                            <label>Keep Finished Rows For (days)</label>
                            <frontend_type>text</frontend_type>
                            <comment><![CDATA[Counted from when a row was sent. Only rows that will not change again are removed, and only once their campaign has nothing left pending: a row still waiting out a retry is never touched, however old the campaign.]]></comment>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                        </keep_days>
                    </fields>
                </cleanup>
                <tracking translate="label">
                    <label>Tracking</label>
                    <sort_order>20</sort_order>
                    <show_in_default>1</show_in_default>
                    <fields>
                        <enabled translate="label">
                            <label>Enable Open/Click Tracking</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                        </enabled>
                    </fields>
                </tracking>
                <ai translate="label comment">
                    <label>AI</label>
                    <comment><![CDATA[Optional. Powers "Suggest" beside a campaign's subject line and "Design with AI" in the template gallery. What is sent to the provider is the wording of the email or your brief and the store's name; no subscriber, customer or order data is ever sent. Each request is billed by the provider to the key below.]]></comment>
                    <sort_order>25</sort_order>
                    <show_in_default>1</show_in_default>
                    <fields>
                        <enabled translate="label">
                            <label>Enable AI Features</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                        </enabled>
                        <provider translate="label comment">
                            <label>Provider</label>
                            <frontend_type>select</frontend_type>
                            <source_model>ysrtech_emailcampaigns/system_config_source_aiprovider</source_model>
                            <comment>OpenRouter gives one key access to models from many companies. OpenAI is used directly with an OpenAI key.</comment>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <depends><enabled>1</enabled></depends>
                        </provider>
                        <api_key translate="label comment">
                            <label>API Key</label>
                            <frontend_type>obscure</frontend_type>
                            <backend_model>adminhtml/system_config_backend_encrypted</backend_model>
                            <comment>Stored encrypted. Set a spending limit on the key at the provider as well.</comment>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                            <depends><enabled>1</enabled></depends>
                        </api_key>
                        <model translate="label comment">
                            <label>Model</label>
                            <frontend_type>text</frontend_type>
                            <comment><![CDATA[The model's id exactly as the provider lists it. On OpenRouter it has the form <em>company/model-name</em>, copied from the model's page there; on OpenAI it is the model name alone.]]></comment>
                            <sort_order>40</sort_order>
                            <show_in_default>1</show_in_default>
                            <depends><enabled>1</enabled></depends>
                        </model>
                        <max_calls_per_hour translate="label comment">
                            <label>Maximum Requests Per Hour</label>
                            <frontend_type>text</frontend_type>
                            <validate>validate-digits validate-greater-than-zero</validate>
                            <comment>Across every admin user. A ceiling on what a mistake or a stuck button can spend.</comment>
                            <sort_order>50</sort_order>
                            <show_in_default>1</show_in_default>
                            <depends><enabled>1</enabled></depends>
                        </max_calls_per_hour>
                        <test translate="label comment">
                            <label>Connection</label>
                            <frontend_type>button</frontend_type>
                            <frontend_model>ysrtech_emailcampaigns/adminhtml_system_config_aitest</frontend_model>
                            <comment>Sends a one-word request with the saved key and model. Save the configuration first: the test reads what is stored, not what is typed above.</comment>
                            <sort_order>60</sort_order>
                            <show_in_default>1</show_in_default>
                            <depends><enabled>1</enabled></depends>
                        </test>
                    </fields>
                </ai>
            </groups>
        </ysrtech_emailcampaigns>
    </sections>
</config>
